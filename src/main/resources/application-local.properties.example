## Example local properties for connecting to Supabase/Postgres
# Copy this to src/main/resources/application-local.properties (or set env vars) and fill values.

# PostgreSQL JDBC URL example (Supabase):
# jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
spring.datasource.url=${DB_URL}
spring.datasource.username=${DB_USER}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.driver-class-name=org.postgresql.Driver

spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

# Supabase REST/API keys (optional, if backend uses Supabase API)
supabase.url=${SUPABASE_URL}
supabase.key=${SUPABASE_KEY}

# For development with H2 fallback, keep H2 settings commented below:
# spring.datasource.url=jdbc:h2:file:./data/forcetrack;DB_CLOSE_DELAY=-1
# spring.datasource.username=sa
# spring.datasource.password=
# spring.datasource.driver-class-name=org.h2.Driver
